# ───────── سَند — إعدادات الخادم (لا تظهر في المتصفح) ─────────
# انسخ هذا الملف إلى .env.local أو اضبط المتغيرات في بيئة التشغيل. لا تضع أسرارًا في متغيرات تبدأ بـ VITE_.

# قاعدة البيانات
# بدون DATABASE_URL يعمل سَند بقاعدة PostgreSQL مدمجة (PGlite) محفوظة في .data/pglite — لا تحتاج تثبيت شيء.
# للإنتاج استخدم PostgreSQL حقيقيًا (Supabase / Neon / RDS ...):
# DATABASE_URL=postgres://user:password@host:5432/sanad?sslmode=require
# PGLITE_DIR=.data/pglite

# Claude (وكيل تحليل السيرة، وكيل البحث عن الوظائف)
# بدونه تعمل قراءة ATS المحلية والمطابقة، ولا يعمل بحث الوظائف على الويب (تبقى الخلاصات JOB_FEEDS والإضافة اليدوية).
# ضع المفتاح هنا في .env.local فقط، ولا تضعه في الكود أو في متغير يبدأ بـ VITE_.
# ANTHROPIC_API_KEY=
# SANAD_CLAUDE_MODEL=claude-opus-5-5

# وكيل الوظائف
# JOBS_AGENT_INTERVAL_HOURS=12
# مصادر وظائف JSON إضافية مفصولة بفواصل (انظر docs/BACKEND.md لصيغة البيانات):
# JOB_FEEDS=https://example.org/deaf-jobs.json

# المشرفون (تشغيل وكيل الوظائف وإضافة وظائف): بريد أو أكثر مفصولة بفواصل
# SANAD_ADMIN_EMAILS=admin@example.com

# مدة الجلسة بالأيام
# SESSION_DAYS=30
