# ───────── سَند — إعدادات الخادم (لا تظهر في المتصفح) ─────────
# انسخ هذا الملف إلى .env.local أو اضبط المتغيرات في بيئة التشغيل. لا تضع أسرارًا في متغيرات تبدأ بـ VITE_.

# قاعدة البيانات
# بدون DATABASE_URL يعمل سَند بقاعدة PostgreSQL مدمجة (PGlite) محفوظة في .data/pglite — لا تحتاج تثبيت شيء.
# للإنتاج استخدم PostgreSQL حقيقيًا (Supabase / Neon / RDS ...):
# DATABASE_URL=postgres://user:password@host:5432/sanad?sslmode=require
# PGLITE_DIR=.data/pglite

# Claude (وكيل السيرة الذاتية، وكيل الوظائف، تبسيط الأسئلة، فهم لغة الإشارة)
# بدونه تعمل الوكلاء بمحركاتها المحلية (تحليل بالقواعد، ترجمة إشارة من المعجم) ولا يعمل بحث الوظائف على الويب.
# ANTHROPIC_API_KEY=
# SANAD_CLAUDE_MODEL=claude-opus-5-5

# لغة الإشارة السعودية — مجلد بيانات SSL (الذي يحتوي dataset/metadata/dataset.csv)
# الافتراضي: ../../Saudi-Sign-Language-main/Saudi-Sign-Language-main بالنسبة لمجلد المشروع
# SSL_DATASET_DIR=C:\Users\me\Downloads\Saudi-Sign-Language-main\Saudi-Sign-Language-main
# التعرّف على الإشارة بالنقاط المرجعية (اختياري؛ انظر docs/BACKEND.md):
# SSL_PYTHON=C:\path\to\venv\Scripts\python.exe
# SSL_LANDMARK_INDEX=.data/ssl-landmarks.npz

# وكيل الوظائف
# JOBS_AGENT_INTERVAL_HOURS=12
# مصادر وظائف JSON إضافية مفصولة بفواصل (انظر docs/BACKEND.md لصيغة البيانات):
# JOB_FEEDS=https://example.org/deaf-jobs.json

# المشرفون (تشغيل الوكلاء وإضافة المترجمين): بريد أو أكثر مفصولة بفواصل
# SANAD_ADMIN_EMAILS=admin@example.com

# مدة الجلسة بالأيام
# SESSION_DAYS=30
